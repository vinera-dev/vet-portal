{
  "name": "vet-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- schema.graphql",
    "predev": "npm run codegen",
    "prebuild": "npm run codegen",
    "pretypecheck": "npm run codegen",
    "pretest": "npm run codegen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.0.1",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/schema-ast": "^7.0.0",
    "@graphql-codegen/typed-document-node": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.0",
    "@graphql-codegen/typescript-operations": "^7.0.0",
    "@graphql-codegen/typescript-resolvers": "^7.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "^5"
  }
}
